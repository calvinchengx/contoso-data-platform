# The pinned stack. Never `latest` — a green run must say WHICH images it
# verified, or it says only that something, somewhere, worked.
#
# The three images are versioned INDEPENDENTLY. That is not an oversight to
# tidy up: fabric-emulator is at 0.13.x while the companions are at 0.3.x,
# because they ship on their own cadences. A consumer has to pin all three, and
# discovering that is part of what this repository is for.
#
# docker compose reads this directly via --env-file, so the names here are the
# variable names the compose files use — one file, no translation layer.
FABRIC_EMULATOR_VERSION=0.13.0
ENTRA_EMULATOR_VERSION=0.3.0
KEYVAULT_EMULATOR_VERSION=0.3.0

# The source-system mock. Pinned for the same reason as the rest.
MOKAPI_VERSION=0.50.0
