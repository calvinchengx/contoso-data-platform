# The pinned stack. Never `latest` — a green run must say WHICH images it
# verified, or it says only that something, somewhere, worked.
#
# The three images are versioned INDEPENDENTLY. That is not an oversight to
# tidy up: fabric-emulator and its companions are on different version lines
# and ship on their own cadences, so they will not agree and are not meant to.
# A consumer has to pin all three, and discovering that is part of what this
# repository is for.
#
# docker compose reads this directly via --env-file, so the names here are the
# variable names the compose files use — one file, no translation layer.
FABRIC_EMULATOR_VERSION=0.18.0
ENTRA_EMULATOR_VERSION=0.3.0
KEYVAULT_EMULATOR_VERSION=0.3.0

# The source-system mock. Pinned for the same reason as the rest.
MOKAPI_VERSION=0.50.0

# The Spark engine. LakeSail's Sail is a Rust Spark-Connect server — PySpark
# semantics with no JVM — published by the emulator project at the same
# cadence, so it pins to the same version as fabric-emulator itself.
SAIL_VERSION=0.18.0

# The statement executor the emulator drives to run a notebook. Published by the
# same release workflow and tagged with the emulator's own version, so it moves
# in lockstep — see scripts/set_release.py.
SPARK_AGENT_VERSION=0.18.0

# The ERP source: a real relational database, its change stream, and the
# connector that reads it. Contoso ERP is not a file drop — it is a system that
# CHANGES, and CDC is the only honest way to ingest one.
POSTGRES_VERSION=16.4
REDPANDA_VERSION=v24.2.7
DEBEZIUM_VERSION=2.7.3.Final

# The Warehouse engine. Fabric's Warehouse is T-SQL over TDS, and the emulator
# terminates FedAuth in front of a real SQL Server — so gold runs against an
# actual T-SQL engine rather than a stand-in.
#
# DIGEST-PINNED: this sidecar IS the warehouse engine, so an unannounced image
# change moves T-SQL behaviour under the assertions.
#
# amd64 only — Microsoft publishes no arm64 manifest. On Apple silicon the
# engine translates this one container; on an arm64 Linux host gold cannot run,
# which is a limitation of SQL Server's distribution, not of this platform.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest@sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89

# The catalog. Heavy — OpenMetadata plus its own Postgres and OpenSearch, which
# alone wants a 1 GB heap — so it is profile-gated and `make up` never starts it.
OPENMETADATA_VERSION=1.13.2
OPENSEARCH_VERSION=3.4.0
