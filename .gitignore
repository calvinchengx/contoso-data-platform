.venv/
__pycache__/
*.egg-info/
capture/shots/
state.json
*_summary.json
sources/_data/

# Personal assistant config — the rules themselves are in RULES.md,
# which is committed so CI and every contributor see them.
CLAUDE.md
CLAUDE.local.md
gold/_export.json
catalog.json
gold/_columns.json
# What `make reconcile` read back from the Warehouse — an observation of a
# particular run, not a fact about the repository.
gold/_reconcile_sql.json

# dbt writes these on every run: the compiled SQL it just built, the manifest
# describing it, and its own log. They are OUTPUTS of gold/models/*.sql, so
# committing them means every run dirties the tree with a rebuild of something
# the repo already holds the source of — and a stale manifest reads like a
# source of truth while describing a project that no longer exists.
# .user.yml is dbt's anonymous-usage id, generated per machine.
gold/target/
gold/logs/
gold/.user.yml

# Emitted by platform/pbip.py — a build output, not a source.
artifacts/

# Local tooling
.nwave/
